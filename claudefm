#!/usr/bin/env bash
# claudefm — minimal CLI player for the claudeFM YouTube radio
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/claudefm"
URL_FILE_XDG="$CONFIG_DIR/url"
URL_FILE_LOCAL="$SCRIPT_DIR/.claudefm.url"
INPUT_CONF_XDG="$CONFIG_DIR/input.conf"
INPUT_CONF_LOCAL="$SCRIPT_DIR/input.conf"
LUA_SCRIPT_XDG="$CONFIG_DIR/stats.lua"
LUA_SCRIPT_LOCAL="$SCRIPT_DIR/stats.lua"

VIDEO_MODE=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    -v|--video) VIDEO_MODE=1; shift ;;
    -h|--help)
      cat <<EOF
Usage: claudefm [-v|--video]

Play the claudeFM YouTube live in your terminal.

Options:
  -v, --video    Render the video as truecolor terminal blocks (mpv --vo=tct).
                 Higher CPU usage. Default: audio only.
  -h, --help     Show this help.

Controls (while playing): space=pause  ↑/↓ or +/-=volume  m=mute  q=quit
EOF
      exit 0 ;;
    *) printf 'unknown option: %s\n' "$1" >&2; exit 1 ;;
  esac
done

require() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'missing dependency: %s\n' "$1" >&2
    exit 1
  fi
}

require yt-dlp
require mpv

if [[ -r "$URL_FILE_XDG" ]]; then
  URL_FILE="$URL_FILE_XDG"
elif [[ -r "$URL_FILE_LOCAL" ]]; then
  URL_FILE="$URL_FILE_LOCAL"
else
  printf 'no URL configured (expected at %s)\n' "$URL_FILE_XDG" >&2
  exit 1
fi

YT_URL="$(tr -d '[:space:]' < "$URL_FILE")"

mapfile -t INFO < <(yt-dlp --no-warnings -f 'bestaudio/worst' \
  --print '%(title)s' \
  --print urls \
  --print '%(concurrent_view_count)s' \
  --print '%(release_timestamp)s' \
  "$YT_URL")
if [[ "${#INFO[@]}" -lt 4 ]]; then
  printf 'yt-dlp failed to resolve %s\n' "$YT_URL" >&2
  exit 1
fi
TITLE="${INFO[0]}"
STREAM_URL="${INFO[1]}"
INITIAL_VIEWERS="${INFO[2]}"
RELEASE_TS="${INFO[3]}"

STATUS_FILE=""
POLLER_PID=""
INITIAL_TITLE="$TITLE"

if (( ! VIDEO_MODE )) && [[ "$INITIAL_VIEWERS" != "NA" && "$RELEASE_TS" != "NA" ]]; then
  STATUS_FILE="$(mktemp -t claudefm-stats.XXXXXX)"
  init_secs=$(( $(date +%s) - RELEASE_TS ))
  init_h=$(( init_secs / 3600 ))
  init_m=$(( (init_secs % 3600) / 60 ))
  INITIAL_TITLE="$(printf '🎧 %s ▁  ·  on for %dh %02dm' "$INITIAL_VIEWERS" "$init_h" "$init_m")"
  printf '%s' "$INITIAL_TITLE" > "$STATUS_FILE"

  (
    set +e
    BUF_SIZE=8
    buffer=( "$INITIAL_VIEWERS" )
    chars=( "▁" "▂" "▃" "▄" "▅" "▆" "▇" "█" )
    while :; do
      sleep 30
      raw="$(yt-dlp --no-warnings --print '%(concurrent_view_count)s' "$YT_URL" 2>/dev/null)"
      [[ -z "$raw" || "$raw" == "NA" ]] && continue
      buffer+=( "$raw" )
      (( ${#buffer[@]} > BUF_SIZE )) && buffer=( "${buffer[@]:1}" )
      min=${buffer[0]}; max=${buffer[0]}
      for v in "${buffer[@]}"; do
        (( v < min )) && min=$v
        (( v > max )) && max=$v
      done
      range=$(( max - min ))
      (( range == 0 )) && range=1
      spark=""
      for v in "${buffer[@]}"; do
        idx=$(( (v - min) * 7 / range ))
        spark+="${chars[idx]}"
      done
      secs=$(( $(date +%s) - RELEASE_TS ))
      h=$(( secs / 3600 ))
      m=$(( (secs % 3600) / 60 ))
      printf '🎧 %s %s  ·  on for %dh %02dm' "$raw" "$spark" "$h" "$m" > "$STATUS_FILE.tmp" \
        && mv "$STATUS_FILE.tmp" "$STATUS_FILE"
    done
  ) &
  POLLER_PID=$!
fi

cleanup() {
  if [[ -n "$POLLER_PID" ]]; then
    kill "$POLLER_PID" 2>/dev/null || true
  fi
  if [[ -n "$STATUS_FILE" ]]; then
    rm -f "$STATUS_FILE" "$STATUS_FILE.tmp"
  fi
}
trap cleanup EXIT INT TERM

if (( VIDEO_MODE )); then
  STATUS_MSG='${?pause==yes:[paused]  }♪ ${media-title}  ·  ${playback-time}'
else
  STATUS_MSG='${?pause==yes:[paused]  }♪ claudeFM  ·  ${media-title}  ·  ${playback-time}'
fi

MPV_ARGS=(
  --msg-level=all=warn,statusline=status
  --force-media-title="$INITIAL_TITLE"
  --term-status-msg="$STATUS_MSG"
)
if [[ -r "$INPUT_CONF_XDG" ]]; then
  MPV_ARGS+=( --input-conf="$INPUT_CONF_XDG" )
elif [[ -r "$INPUT_CONF_LOCAL" ]]; then
  MPV_ARGS+=( --input-conf="$INPUT_CONF_LOCAL" )
fi
if [[ -n "$STATUS_FILE" ]]; then
  if [[ -r "$LUA_SCRIPT_XDG" ]]; then
    MPV_ARGS+=( --script="$LUA_SCRIPT_XDG" --script-opts="statspath=$STATUS_FILE" )
  elif [[ -r "$LUA_SCRIPT_LOCAL" ]]; then
    MPV_ARGS+=( --script="$LUA_SCRIPT_LOCAL" --script-opts="statspath=$STATUS_FILE" )
  fi
fi
if (( VIDEO_MODE )); then
  MPV_ARGS+=( --vo=tct )
else
  MPV_ARGS+=( --no-video )
fi

mpv "${MPV_ARGS[@]}" "$STREAM_URL"
