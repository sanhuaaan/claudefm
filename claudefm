#!/usr/bin/env bash
# claudefm — minimal CLI player for the claudeFM YouTube radio
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
URL_FILE="$SCRIPT_DIR/.claudefm.url"

require() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'missing dependency: %s\n' "$1" >&2
    exit 1
  fi
}

require yt-dlp
require mpv

if [[ ! -r "$URL_FILE" ]]; then
  printf 'no URL configured at %s\n' "$URL_FILE" >&2
  exit 1
fi

YT_URL="$(tr -d '[:space:]' < "$URL_FILE")"

printf '→ resolving stream...\n'
mapfile -t INFO < <(yt-dlp --no-warnings -f 'bestaudio/worst' --print '%(title)s' --print urls "$YT_URL")
if [[ "${#INFO[@]}" -lt 2 ]]; then
  printf 'yt-dlp failed to resolve %s\n' "$YT_URL" >&2
  exit 1
fi
TITLE="${INFO[0]}"
STREAM_URL="${INFO[1]}"

STATUS_MSG='${?pause==yes:[paused]  }♪ ${media-title}  ·  ${playback-time}  ·  vol ${volume}%'

exec mpv \
  --no-video \
  --msg-level=all=warn,statusline=status \
  --force-media-title="$TITLE" \
  --term-status-msg="$STATUS_MSG" \
  "$STREAM_URL"
